<Window x:Class="CherBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="CherBot" Icon="Assets/cherbot.png" Width="1280" Height="820" MinWidth="720" MinHeight="480"
        Background="#121318" WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" />
        <Border x:Name="Fallback" Visibility="Collapsed" Background="#1b1d24" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                <TextBlock Text="CherBot" FontSize="24" FontWeight="Bold" Foreground="#f06283" />
                <TextBlock x:Name="FallbackText" Margin="0,12,0,16" TextWrapping="Wrap" Foreground="#e6e7ea" FontSize="14" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenBrowser" Content="Open in browser" Padding="12,6" Click="OpenBrowser_Click" />
                    <Button x:Name="GetRuntime" Content="Get the WebView2 runtime" Padding="12,6" Margin="8,0,0,0" Click="GetRuntime_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
