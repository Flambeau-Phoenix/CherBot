<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>cherbot</AssemblyName>
    <RootNamespace>CherBot.Host</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <UserSecretsId>cherbot-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="webui\**" Exclude="webui\package.json" />
    <Content Remove="webui\**" />
    <None Remove="webui\**" />
    <EmbeddedResource Include="..\..\docs\operating-guide.md" Link="webui\help\docs\operating-guide.md" />
    <EmbeddedResource Include="..\..\docs\configuration-reference.md" Link="webui\help\docs\configuration-reference.md" />
    <EmbeddedResource Include="..\..\packaging\cherbot.example.json" LogicalName="CherBot.DefaultConfig.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CherBot.Compat\CherBot.Compat.csproj" />
    <ProjectReference Include="..\CherBot.Core\CherBot.Core.csproj" />
    <ProjectReference Include="..\CherBot.Integrations\CherBot.Integrations.csproj" />
    <ProjectReference Include="..\CherBot.Scripting\CherBot.Scripting.csproj" />
    <ProjectReference Include="..\CherBot.Storage\CherBot.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CherBot.Tests" />
    <InternalsVisibleTo Include="CherBot.Desktop" />
  </ItemGroup>

</Project>
